<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:userControls="clr-namespace:Valt.UI.UserControls"
        xmlns:soldAssetHistory="clr-namespace:Valt.UI.Views.Main.Modals.SoldAssetHistory"
        mc:Ignorable="d"
        x:Class="Valt.UI.Views.Main.Modals.SoldAssetHistory.SoldAssetHistoryView"
        Title="{Binding WindowTitle}"
        x:DataType="soldAssetHistory:SoldAssetHistoryViewModel"
        d:DesignWidth="850"
        d:DesignHeight="650"
        MinWidth="850"
        MinHeight="650"
        MaxWidth="850"
        MaxHeight="650"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None"
        ExtendClientAreaTitleBarHeightHint="0">
    <Design.DataContext>
        <soldAssetHistory:SoldAssetHistoryViewModel />
    </Design.DataContext>
    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
    </Window.KeyBindings>
    <Border>
        <Grid RowDefinitions="Auto, *, Auto">
            <userControls:CustomTitleBar Grid.Row="0" Title="{Binding WindowTitle}"
                                         TitleBarPressed="CustomTitleBarButtonPressed"
                                         CloseClick="CustomTitleBarCloseClicked" />

            <Grid Grid.Row="1" ColumnDefinitions="*, 350" Margin="10">
                <Border Grid.Column="0"
                        Background="{DynamicResource Background800Brush}"
                        BorderBrush="{DynamicResource Background600Brush}"
                        BorderThickness="1"
                        CornerRadius="8" />

                <Border Grid.Column="1"
                        Margin="10,0,0,0"
                        Background="{DynamicResource Background800Brush}"
                        BorderBrush="{DynamicResource Background600Brush}"
                        BorderThickness="1"
                        CornerRadius="8" />
            </Grid>

            <Border Grid.Row="2"
                    Classes="form-fields-area"
                    VerticalAlignment="Stretch"
                    Margin="10"
                    Padding="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Close"
                            HorizontalContentAlignment="Center"
                            Command="{Binding CloseCommand}"
                            Width="100" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
