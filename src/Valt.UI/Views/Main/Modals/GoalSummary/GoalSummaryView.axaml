<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:userControls="clr-namespace:Valt.UI.UserControls"
        xmlns:lang="clr-namespace:Valt.UI.Lang"
        xmlns:goalSummary="clr-namespace:Valt.UI.Views.Main.Modals.GoalSummary"
        mc:Ignorable="d"
        x:Class="Valt.UI.Views.Main.Modals.GoalSummary.GoalSummaryView"
        Title="{Binding WindowTitle}"
        x:DataType="goalSummary:GoalSummaryViewModel"
        d:DesignWidth="800" d:DesignHeight="560"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None"
        ExtendClientAreaTitleBarHeightHint="0">
    <Design.DataContext>
        <goalSummary:GoalSummaryViewModel />
    </Design.DataContext>
    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
    </Window.KeyBindings>
    <Border>
        <Grid RowDefinitions="Auto, *, Auto">
            <userControls:CustomTitleBar Grid.Row="0" Title="{Binding WindowTitle}"
                                         TitleBarPressed="CustomTitleBarButtonPressed"
                                         CloseClick="CustomTitleBarCloseClicked" />

            <Grid Grid.Row="1" RowDefinitions="Auto, *" Margin="12">
                <!-- Header strip: goal identity / period / focal-point reconciled total -->
                <Border Grid.Row="0"
                        Background="{DynamicResource Background800Brush}"
                        BorderBrush="{DynamicResource Background500Brush}"
                        BorderThickness="1"
                        Padding="8"
                        Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <TextBlock Text="{Binding GoalName}"
                                   FontSize="{DynamicResource FontSizeNormal}"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource Geist}"
                                   MaxWidth="360"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static lang:language.GoalSummary_PeriodLabel}"
                                       FontSize="{DynamicResource FontSizeNormal}"
                                       Foreground="{DynamicResource Text400Brush}"
                                       FontFamily="{DynamicResource Geist}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PeriodLabel}"
                                       FontSize="{DynamicResource FontSizeNormal}"
                                       FontFamily="{DynamicResource Geist}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static lang:language.GoalSummary_TotalLabel}"
                                       FontSize="{DynamicResource FontSizeNormal}"
                                       Foreground="{DynamicResource Text400Brush}"
                                       FontFamily="{DynamicResource Geist}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FinalTotalFormatted}"
                                       FontSize="{DynamicResource FontSizeLarge}"
                                       FontWeight="SemiBold"
                                       FontFamily="{DynamicResource GeistMono}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <DataGrid Grid.Row="1"
                          GridLinesVisibility="All"
                          ItemsSource="{Binding Rows}"
                          CanUserResizeColumns="True"
                          IsReadOnly="True"
                          IsVisible="{Binding HasRows}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static lang:language.Transactions_Columns_Date}" Width="90"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                            FontFamily="{DynamicResource Geist}"
                                            Binding="{Binding DateFormatted}" />
                        <DataGridTemplateColumn Header="{x:Static lang:language.Transactions_Columns_Description}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="goalSummary:GoalSummaryViewModel+RowItemViewModel">
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               FontFamily="{DynamicResource Geist}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{x:Static lang:language.GoalSummary_ColumnAccount}" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="goalSummary:GoalSummaryViewModel+RowItemViewModel">
                                    <TextBlock Text="{Binding AccountName}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               FontFamily="{DynamicResource Geist}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{x:Static lang:language.GoalSummary_ColumnCategory}" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="goalSummary:GoalSummaryViewModel+RowItemViewModel">
                                    <TextBlock Text="{Binding CategoryName}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               FontFamily="{DynamicResource Geist}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{x:Static lang:language.GoalSummary_ColumnFiat}" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="goalSummary:GoalSummaryViewModel+RowItemViewModel">
                                    <TextBlock Text="{Binding FiatFormatted}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               FontFamily="{DynamicResource GeistMono}"
                                               Foreground="{Binding ContributionForeground}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{x:Static lang:language.GoalSummary_ColumnSats}" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="goalSummary:GoalSummaryViewModel+RowItemViewModel">
                                    <TextBlock Text="{Binding SatsFormatted}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               FontFamily="{DynamicResource GeistMono}"
                                               Foreground="{Binding ContributionForeground}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{x:Static lang:language.GoalSummary_ColumnRunningTotal}" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="goalSummary:GoalSummaryViewModel+RowItemViewModel">
                                    <TextBlock Text="{Binding RunningTotalFormatted}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               FontFamily="{DynamicResource GeistMono}"
                                               Foreground="{Binding ContributionForeground}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1"
                        IsVisible="{Binding !HasRows}"
                        Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Static lang:language.GoalSummary_EmptyTitle}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource Geist}"
                                   Foreground="{DynamicResource Text400Brush}" />
                        <TextBlock Text="{x:Static lang:language.GoalSummary_EmptyMessage}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   FontFamily="{DynamicResource Geist}"
                                   Foreground="{DynamicResource Text400Brush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Classes="form-fields-area"
                    VerticalAlignment="Stretch"
                    Margin="12"
                    Padding="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="{x:Static lang:language.GoalSummary_Close}"
                            HorizontalContentAlignment="Center"
                            Command="{Binding CloseCommand}"
                            Width="100" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
