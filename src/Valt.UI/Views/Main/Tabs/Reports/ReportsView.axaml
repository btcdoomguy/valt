<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:reports1="clr-namespace:Valt.UI.Views.Main.Tabs.Reports"
             xmlns:userControls="clr-namespace:Valt.UI.UserControls"
             xmlns:avalonia="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:draw="clr-namespace:LiveChartsCore.SkiaSharpView.Drawing.Geometries;assembly=LiveChartsCore.SkiaSharpView"
             xmlns:skiaSharp="clr-namespace:SkiaSharp;assembly=SkiaSharp"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:immutable="clr-namespace:System.Collections.Immutable;assembly=System.Collections.Immutable"
             xmlns:models="clr-namespace:Valt.UI.Views.Main.Tabs.Reports.Models"
             xmlns:lang="clr-namespace:Valt.UI.Lang"
             xmlns:painting="clr-namespace:LiveChartsCore.SkiaSharpView.Painting;assembly=LiveChartsCore.SkiaSharpView"
             xmlns:wealthOverview="clr-namespace:Valt.Infra.Modules.Reports.WealthOverview;assembly=Valt.Infra"
             xmlns:converters="clr-namespace:Valt.UI.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="1200"
             MinWidth="900"
             x:Class="Valt.UI.Views.Main.Tabs.Reports.ReportsView"
             x:DataType="reports1:ReportsViewModel">
    <Design.DataContext>
        <reports1:ReportsViewModel />
    </Design.DataContext>
    <UserControl.Resources>
        <converters:WealthOverviewPeriodConverter x:Key="WealthOverviewPeriodConverter" />
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" IsVisible="{Binding !IsSecureModeEnabled}" Margin="0,8,16,0">
            <Button Classes="transparent"
                    Padding="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding OpenReportsCategoryFilterConfigCommand}"
                    ToolTip.Tip="{x:Static lang:language.Reports_CategoryFilter_Tooltip}">
                <TextBlock FontFamily="{DynamicResource MaterialDesign}" Text="&#xE8B8;" FontSize="18"
                           Foreground="{DynamicResource Text300Brush}" />
            </Button>
        </Grid>
        <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsSecureModeEnabled}" Margin="0, 8, 0, 0">
        <StackPanel Margin="16">
            <!--Summary-->
            <Expander Classes="section" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="section-header-icon" Text="&#xE1B1;" />
                        <TextBlock Classes="section-header" Text="{x:Static lang:language.Reports_Summary}" />
                    </StackPanel>
                </Expander.Header>
                
                <StackPanel>
                    <!-- Fixed Price Bar -->
                    <Border Classes="card" Margin="0,0,0,12" IsVisible="{Binding !IsSecureModeEnabled}">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,*" Margin="12,8">
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Background="{DynamicResource WarningBrush}" 
                                        CornerRadius="4" 
                                        Padding="4,2" 
                                        IsVisible="{Binding IsCustomPriceActive}">
                                    <TextBlock Text="SIMULAÇÃO" 
                                               FontSize="10" 
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource BackgroundBrush}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="24,0">
                                <TextBlock Text="{x:Static lang:language.Reports_FixedPriceBar_CurrentPrice}" 
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Foreground="{DynamicResource Text300Brush}" />
                                <TextBlock Text="{Binding CurrentBtcPriceFormatted}" 
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text100Brush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="24,0,0,0">
                                <Button Content="{x:Static lang:language.Reports_ResetButton}"
                                        Command="{Binding ResetFixedPriceCommand}"
                                        IsEnabled="{Binding IsCustomPriceActive}"
                                        Classes="secondary" />
                                <Button Content="{Binding SimulateButtonText}"
                                        Command="{Binding OpenFixedPriceConfigCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <reports1:DashboardGridPanel>
                    <!-- Wealth Dashboard -->
                    <Grid MinHeight="150"
                          reports1:DashboardGridPanel.RowSpan="{Binding WealthData.IsLarge, Converter={x:Static reports1:DashboardGridPanel.IsLargeToRowSpanConverter}}">
                        <Panel IsVisible="{Binding !IsWealthLoading}">
                            <reports1:DashboardDataUserControl DataContext="{Binding WealthData}" />
                        </Panel>
                        <TextBlock Text="{x:Static lang:language.Loading}" FontSize="{DynamicResource FontSizeMedium}" Foreground="{DynamicResource Text400Brush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding IsWealthLoading}" />
                    </Grid>
                    <!-- All Time High Dashboard -->
                    <Grid MinHeight="150"
                          reports1:DashboardGridPanel.RowSpan="{Binding AllTimeHighData.IsLarge, Converter={x:Static reports1:DashboardGridPanel.IsLargeToRowSpanConverter}}">
                        <Panel IsVisible="{Binding !IsAllTimeHighLoading}">
                            <reports1:DashboardDataUserControl DataContext="{Binding AllTimeHighData}" />
                        </Panel>
                        <TextBlock Text="{x:Static lang:language.Loading}" FontSize="{DynamicResource FontSizeMedium}" Foreground="{DynamicResource Text400Brush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding IsAllTimeHighLoading}" />
                    </Grid>
                    <!-- BTC Stack Dashboard -->
                    <Grid MinHeight="150"
                          reports1:DashboardGridPanel.RowSpan="{Binding BtcStackData.IsLarge, Converter={x:Static reports1:DashboardGridPanel.IsLargeToRowSpanConverter}}">
                        <Panel IsVisible="{Binding !IsBtcStackLoading}">
                            <reports1:DashboardDataUserControl DataContext="{Binding BtcStackData}" />
                        </Panel>
                        <TextBlock Text="{x:Static lang:language.Loading}" FontSize="{DynamicResource FontSizeMedium}" Foreground="{DynamicResource Text400Brush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding IsBtcStackLoading}" />
                    </Grid>
                    <!-- Statistics Dashboard -->
                    <Grid MinHeight="150"
                          reports1:DashboardGridPanel.RowSpan="{Binding StatisticsData.IsLarge, Converter={x:Static reports1:DashboardGridPanel.IsLargeToRowSpanConverter}}">
                        <Panel IsVisible="{Binding !IsStatisticsLoading}">
                            <reports1:DashboardDataUserControl DataContext="{Binding StatisticsData}" />
                        </Panel>
                        <TextBlock Text="{x:Static lang:language.Loading}" FontSize="{DynamicResource FontSizeMedium}" Foreground="{DynamicResource Text400Brush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding IsStatisticsLoading}" />
                    </Grid>
                    <!-- Burn Rate Dashboard -->
                    <Grid MinHeight="150"
                          IsVisible="{Binding IsBurnRateVisible}"
                          reports1:DashboardGridPanel.RowSpan="{Binding BurnRateData.IsLarge, Converter={x:Static reports1:DashboardGridPanel.IsLargeToRowSpanConverter}}">
                        <Panel IsVisible="{Binding !IsBurnRateLoading}">
                            <reports1:DashboardDataUserControl DataContext="{Binding BurnRateData}" />
                        </Panel>
                        <TextBlock Text="{x:Static lang:language.Loading}" FontSize="{DynamicResource FontSizeMedium}" Foreground="{DynamicResource Text400Brush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding IsBurnRateLoading}" />
                    </Grid>
                    <!-- Indicators Dashboard -->
                    <Grid MinHeight="150"
                          reports1:DashboardGridPanel.RowSpan="{Binding IndicatorsData.IsLarge, Converter={x:Static reports1:DashboardGridPanel.IsLargeToRowSpanConverter}}">
                        <Panel IsVisible="{Binding !IsIndicatorsLoading}">
                            <reports1:DashboardDataUserControl DataContext="{Binding IndicatorsData}" />
                        </Panel>
                        <TextBlock Text="{x:Static lang:language.Loading}" FontSize="{DynamicResource FontSizeMedium}" Foreground="{DynamicResource Text400Brush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding IsIndicatorsLoading}" />
                    </Grid>
                    <!-- Simulated Prices Dashboard -->
                    <Grid MinHeight="150"
                          reports1:DashboardGridPanel.RowSpan="{Binding SimulatedPricesData.IsLarge, Converter={x:Static reports1:DashboardGridPanel.IsLargeToRowSpanConverter}}">
                        <Panel IsVisible="{Binding !IsSimulatedPricesLoading}">
                            <reports1:DashboardDataUserControl DataContext="{Binding SimulatedPricesData}" />
                        </Panel>
                        <TextBlock Text="{x:Static lang:language.Loading}" FontSize="{DynamicResource FontSizeMedium}" Foreground="{DynamicResource Text400Brush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding IsSimulatedPricesLoading}" />
                    </Grid>
                    <!-- Leverage Positions Dashboard -->
                    <Grid MinHeight="150"
                          IsVisible="{Binding IsLeveragePositionsVisible}"
                          reports1:DashboardGridPanel.RowSpan="{Binding LeveragePositionsData.IsLarge, Converter={x:Static reports1:DashboardGridPanel.IsLargeToRowSpanConverter}}">
                        <Panel IsVisible="{Binding !IsLeveragePositionsLoading}">
                            <reports1:DashboardDataUserControl DataContext="{Binding LeveragePositionsData}" />
                        </Panel>
                        <TextBlock Text="{x:Static lang:language.Loading}" FontSize="{DynamicResource FontSizeMedium}" Foreground="{DynamicResource Text400Brush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding IsLeveragePositionsLoading}" />
                    </Grid>
                    <!-- BTC Loans Dashboard -->
                    <Grid MinHeight="150"
                          IsVisible="{Binding IsBtcLoansVisible}"
                          reports1:DashboardGridPanel.RowSpan="{Binding BtcLoansData.IsLarge, Converter={x:Static reports1:DashboardGridPanel.IsLargeToRowSpanConverter}}">
                        <Panel IsVisible="{Binding !IsBtcLoansLoading}">
                            <reports1:DashboardDataUserControl DataContext="{Binding BtcLoansData}" />
                        </Panel>
                        <TextBlock Text="{x:Static lang:language.Loading}" FontSize="{DynamicResource FontSizeMedium}" Foreground="{DynamicResource Text400Brush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding IsBtcLoansLoading}" />
                    </Grid>
                </reports1:DashboardGridPanel>
                </StackPanel>
            </Expander>
            <!--Wealth Overview-->
            <Expander Classes="section" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="section-header-icon" Text="&#xE6DF;" />
                        <TextBlock Classes="section-header" Text="{x:Static lang:language.Reports_WealthOverview_Title}" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{x:Static lang:language.Reports_WealthOverview_Description}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource Text500Brush}"
                               TextWrapping="Wrap"
                               MaxWidth="900"
                               Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Center" Spacing="10">
                        <ComboBox SelectedItem="{Binding SelectedWealthOverviewPeriod}" MinWidth="150">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource WealthOverviewPeriodConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <wealthOverview:WealthOverviewPeriod>Daily</wealthOverview:WealthOverviewPeriod>
                            <wealthOverview:WealthOverviewPeriod>Weekly</wealthOverview:WealthOverviewPeriod>
                            <wealthOverview:WealthOverviewPeriod>Monthly</wealthOverview:WealthOverviewPeriod>
                            <wealthOverview:WealthOverviewPeriod>Yearly</wealthOverview:WealthOverviewPeriod>
                        </ComboBox>
                        <ComboBox SelectedItem="{Binding SelectedWealthOverviewMaxElements}" MinWidth="80">
                            <system:Int32>12</system:Int32>
                            <system:Int32>18</system:Int32>
                            <system:Int32>24</system:Int32>
                        </ComboBox>
                    </StackPanel>
                    <Grid MinHeight="500">
                        <Border Background="{DynamicResource Background900Brush}"
                                BorderBrush="{DynamicResource Background700Brush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10"
                                IsVisible="{Binding !IsWealthOverviewLoading}">
                            <avalonia:CartesianChart
                                x:Name="WealthOverviewChart"
                                Background="{DynamicResource Background900Brush}"
                                Series="{Binding WealthOverviewChartData.Series}"
                                XAxes="{Binding WealthOverviewChartData.XAxes}"
                                YAxes="{Binding WealthOverviewChartData.YAxes}"
                                LegendPosition="Top"
                                LegendTextSize="13"
                                TooltipTextSize="12"
                                ZoomMode="None"
                                Height="480"
                                Margin="20, 10, 20, 10">
                            </avalonia:CartesianChart>
                        </Border>
                        <TextBlock Text="{x:Static lang:language.Loading}" FontSize="{DynamicResource FontSizeMedium}" Foreground="{DynamicResource Text400Brush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding IsWealthOverviewLoading}" />
                    </Grid>
                    <TextBlock Text="{x:Static lang:language.Reports_DoesntIncludeAssets}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource Text500Brush}"
                               Margin="0, 5, 0, 0" />
                </StackPanel>
            </Expander>
            <!--Monthly totals-->
            <Expander Classes="section" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="section-header-icon" Text="&#xE24B;" />
                        <TextBlock Classes="section-header" Text="{x:Static lang:language.Reports_MonthlyTotals}" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{x:Static lang:language.Reports_MonthlyTotals_Description}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource Text500Brush}"
                               TextWrapping="Wrap"
                               MaxWidth="900"
                               Margin="0,0,0,12" />
                    <userControls:DateCalendarSelector HorizontalContentAlignment="Center"
                                                       Height="60"
                                                       Date="{Binding FilterMainDate}"
                                                       Range="{Binding FilterRange}">
                        <userControls:DateCalendarSelector.AllowedSelectorModes>
                            <userControls:DateCalendarSelectorMode>Year</userControls:DateCalendarSelectorMode>
                            <userControls:DateCalendarSelectorMode>All</userControls:DateCalendarSelectorMode>
                        </userControls:DateCalendarSelector.AllowedSelectorModes>
                    </userControls:DateCalendarSelector>
                    <Grid MinHeight="400">
                        <Panel IsVisible="{Binding !IsMonthlyTotalsLoading}">
                            <DataGrid
                                x:Name="MonthlyTotalsGrid"
                                Margin="0, 10, 0, 0"
                                GridLinesVisibility="All"
                                ItemsSource="{Binding MonthlyReportItems}"
                                IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{x:Static lang:language.Reports_MonthlyTotals_Date}"
                                                        Binding="{Binding MonthYearFormatted}">
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Bitcoin" Binding="{Binding BtcTotalFormatted}"></DataGridTextColumn>
                                    <DataGridTemplateColumn
                                        Header="{x:Static lang:language.Reports_MonthlyTotals_PreviousMonth}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="models:MonthlyReportItemViewModel">
                                                <TextBlock Classes="only-text"
                                                           Text="{Binding BtcMonthlyChangeFormatted}"
                                                           Foreground="{Binding BtcMonthlyChangeColor}">
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn
                                        Header="{x:Static lang:language.Reports_MonthlyTotals_PreviousYear}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="models:MonthlyReportItemViewModel">
                                                <TextBlock Classes="only-text"
                                                           Text="{Binding BtcYearlyChangeFormatted}"
                                                           Foreground="{Binding BtcYearlyChangeColor}">
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn
                                        Header="{x:Static lang:language.Reports_MonthlyTotals_TotalWealth}"
                                        Binding="{Binding FiatTotalFormatted}">
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn
                                        Header="{x:Static lang:language.Reports_MonthlyTotals_PreviousMonth}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="models:MonthlyReportItemViewModel">
                                                <TextBlock Classes="only-text"
                                                           Text="{Binding FiatMonthlyChangeFormatted}"
                                                           Foreground="{Binding FiatMonthlyChangeColor}">
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn
                                        Header="{x:Static lang:language.Reports_MonthlyTotals_PreviousYear}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="models:MonthlyReportItemViewModel">
                                                <TextBlock Classes="only-text"
                                                           Text="{Binding FiatYearlyChangeFormatted}"
                                                           Foreground="{Binding FiatYearlyChangeColor}">
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{x:Static lang:language.Reports_MonthlyTotals_AllIncomeInFiat}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="models:MonthlyReportItemViewModel">
                                                <TextBlock Classes="only-text" Text="{Binding AllIncomeInFiatFormatted}">
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{x:Static lang:language.Reports_MonthlyTotals_AllExpensesInFiat}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="models:MonthlyReportItemViewModel">
                                                <TextBlock Classes="only-text" Text="{Binding AllExpensesInFiatFormatted}">
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{x:Static lang:language.Reports_MonthlyTotals_Income}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="models:MonthlyReportItemViewModel">
                                                <TextBlock Classes="only-text" Text="{Binding IncomeFormatted}">
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{x:Static lang:language.Reports_MonthlyTotals_Expenses}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="models:MonthlyReportItemViewModel">
                                                <TextBlock Classes="only-text" Text="{Binding ExpensesFormatted}">
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{x:Static lang:language.Reports_MonthlyTotals_BitcoinPurchased}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="models:MonthlyReportItemViewModel">
                                                <TextBlock Classes="only-text"
                                                           Text="{Binding BitcoinPurchasedFormatted}">
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{x:Static lang:language.Reports_MonthlyTotals_BitcoinSold}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="models:MonthlyReportItemViewModel">
                                                <TextBlock Classes="only-text" Text="{Binding BitcoinSoldFormatted}">
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{x:Static lang:language.Reports_MonthlyTotals_BitcoinIncome}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="models:MonthlyReportItemViewModel">
                                                <TextBlock Classes="only-text" Text="{Binding BitcoinIncomeFormatted}">
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{x:Static lang:language.Reports_MonthlyTotals_BitcoinExpenses}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="models:MonthlyReportItemViewModel">
                                                <TextBlock Classes="only-text"
                                                           Text="{Binding BitcoinExpensesFormatted}">
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Panel>
                        <TextBlock Text="{x:Static lang:language.Loading}" FontSize="{DynamicResource FontSizeMedium}" Foreground="{DynamicResource Text400Brush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding IsMonthlyTotalsLoading}" />
                    </Grid>
                    <TextBlock Text="{x:Static lang:language.Reports_DoesntIncludeAssets}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource Text500Brush}"
                               Margin="0, 5, 0, 0" />
                </StackPanel>
            </Expander>
            <!--Fixed vs variable expenses-->
            <Expander Classes="section" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="section-header-icon" Text="&#xE9E6;" />
                        <TextBlock Classes="section-header" Text="{x:Static lang:language.Reports_FixedVariable_Title}" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{x:Static lang:language.Reports_FixedVariable_Description}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource Text500Brush}"
                               TextWrapping="Wrap"
                               MaxWidth="900"
                               Margin="0,0,0,12" />
                    <Grid MinHeight="400">
                        <Panel IsVisible="{Binding !IsFixedVsVariableLoading}">
                            <Border Classes="hint-box"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding HasNoFixedExpenses}">
                                <StackPanel Orientation="Vertical" Spacing="8">
                                    <TextBlock Text="{x:Static lang:language.Reports_FixedVariable_EmptyNoneHeading}"
                                               FontSize="{DynamicResource FontSizeLarge}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text200Brush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Static lang:language.Reports_FixedVariable_EmptyNoneBody}"
                                               FontSize="{DynamicResource FontSizeNormal}"
                                               Foreground="{DynamicResource Text400Brush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               MaxWidth="500"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Panel IsVisible="{Binding !HasNoFixedExpenses}">
                                <Border Background="{DynamicResource Background900Brush}"
                                        BorderBrush="{DynamicResource Background700Brush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10"
                                        IsVisible="{Binding !IsFixedVsVariableEmpty}">
                                    <avalonia:CartesianChart
                                        x:Name="FixedVsVariableChart"
                                        Background="{DynamicResource Background900Brush}"
                                        Series="{Binding FixedVsVariableChartData.Series}"
                                        XAxes="{Binding FixedVsVariableChartData.XAxes}"
                                        YAxes="{Binding FixedVsVariableChartData.YAxes}"
                                        LegendPosition="Top"
                                        LegendTextSize="13"
                                        TooltipTextSize="12"
                                        ZoomMode="None"
                                        Height="400"
                                        Margin="20, 10, 20, 10">
                                    </avalonia:CartesianChart>
                                </Border>
                                <Border Classes="hint-box"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        IsVisible="{Binding IsFixedVsVariableEmpty}">
                                    <StackPanel Orientation="Vertical" Spacing="8">
                                        <TextBlock Text="{x:Static lang:language.Reports_FixedVariable_EmptyPeriod}"
                                                   FontSize="{DynamicResource FontSizeNormal}"
                                                   Foreground="{DynamicResource Text400Brush}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   MaxWidth="500"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Panel>
                        </Panel>
                        <TextBlock Text="{x:Static lang:language.Loading}" FontSize="{DynamicResource FontSizeMedium}" Foreground="{DynamicResource Text400Brush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding IsFixedVsVariableLoading}" />
                    </Grid>
                </StackPanel>
            </Expander>
            <!--Sats earned & spent-->
            <Expander Classes="section" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="section-header-icon" Text="&#xEBC5;" />
                        <TextBlock Classes="section-header" Text="{x:Static lang:language.Reports_BtcMetrics_Title}" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{x:Static lang:language.Reports_BtcMetrics_Description}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource Text500Brush}"
                               TextWrapping="Wrap"
                               MaxWidth="900"
                               Margin="0,0,0,12" />
                    <Grid MinHeight="400">
                        <Panel IsVisible="{Binding !IsBtcMetricsLoading}">
                            <Panel IsVisible="{Binding !IsBtcMetricsError}">
                                <Border Background="{DynamicResource Background900Brush}"
                                        BorderBrush="{DynamicResource Background700Brush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10"
                                        IsVisible="{Binding !IsBtcMetricsEmpty}">
                                    <avalonia:CartesianChart
                                        x:Name="BtcDenominatedMetricsChart"
                                        Background="{DynamicResource Background900Brush}"
                                        Series="{Binding BtcDenominatedMetricsChartData.Series}"
                                        XAxes="{Binding BtcDenominatedMetricsChartData.XAxes}"
                                        YAxes="{Binding BtcDenominatedMetricsChartData.YAxes}"
                                        LegendPosition="Top"
                                        LegendTextSize="13"
                                        TooltipTextSize="12"
                                        ZoomMode="None"
                                        Height="400"
                                        Margin="20, 10, 20, 10">
                                    </avalonia:CartesianChart>
                                </Border>
                                <Border Classes="hint-box"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        IsVisible="{Binding IsBtcMetricsEmpty}">
                                    <StackPanel Orientation="Vertical" Spacing="8">
                                        <TextBlock Text="{x:Static lang:language.Reports_BtcMetrics_EmptyHeading}"
                                                   FontSize="{DynamicResource FontSizeLarge}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text200Brush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Static lang:language.Reports_BtcMetrics_EmptyBody}"
                                                   FontSize="{DynamicResource FontSizeNormal}"
                                                   Foreground="{DynamicResource Text400Brush}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   MaxWidth="500"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Panel>
                            <Border Classes="hint-box"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding IsBtcMetricsError}">
                                <StackPanel Orientation="Vertical" Spacing="8">
                                    <TextBlock Text="{x:Static lang:language.Reports_BtcMetrics_ErrorTitle}"
                                               FontSize="{DynamicResource FontSizeLarge}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text200Brush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Static lang:language.Reports_BtcMetrics_ErrorBody}"
                                                   FontSize="{DynamicResource FontSizeNormal}"
                                                   Foreground="{DynamicResource Text400Brush}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   MaxWidth="500"
                                                   HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Panel>
                        <TextBlock Text="{x:Static lang:language.Loading}" FontSize="{DynamicResource FontSizeMedium}" Foreground="{DynamicResource Text400Brush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding IsBtcMetricsLoading}" />
                    </Grid>
                </StackPanel>
            </Expander>
            <!--Stack velocity-->
            <Expander Classes="section" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="section-header-icon" Text="&#xE9E4;" />
                        <TextBlock Classes="section-header" Text="{x:Static lang:language.Reports_StackVelocity_Title}" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{x:Static lang:language.Reports_StackVelocity_Description}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource Text500Brush}"
                               TextWrapping="Wrap"
                               MaxWidth="900"
                               Margin="0,0,0,12" />
                    <Grid MinHeight="400">
                        <Panel IsVisible="{Binding !IsStackVelocityLoading}">
                            <Panel IsVisible="{Binding !IsStackVelocityError}">
                                <Border Background="{DynamicResource Background900Brush}"
                                        BorderBrush="{DynamicResource Background700Brush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10"
                                        IsVisible="{Binding !IsStackVelocityEmpty}">
                                    <avalonia:CartesianChart
                                        x:Name="StackVelocityChart"
                                        Background="{DynamicResource Background900Brush}"
                                        Series="{Binding StackVelocityChartData.Series}"
                                        XAxes="{Binding StackVelocityChartData.XAxes}"
                                        YAxes="{Binding StackVelocityChartData.YAxes}"
                                        LegendPosition="Top"
                                        LegendTextSize="13"
                                        TooltipTextSize="12"
                                        ZoomMode="None"
                                        Height="400"
                                        Margin="20, 10, 20, 10">
                                    </avalonia:CartesianChart>
                                </Border>
                                <Border Classes="hint-box"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        IsVisible="{Binding IsStackVelocityEmpty}">
                                    <StackPanel Orientation="Vertical" Spacing="8">
                                        <TextBlock Text="{x:Static lang:language.Reports_StackVelocity_EmptyHeading}"
                                                   FontSize="{DynamicResource FontSizeLarge}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text200Brush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Static lang:language.Reports_StackVelocity_EmptyBody}"
                                                   FontSize="{DynamicResource FontSizeNormal}"
                                                   Foreground="{DynamicResource Text400Brush}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   MaxWidth="500"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Panel>
                            <Border Classes="hint-box"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding IsStackVelocityError}">
                                <StackPanel Orientation="Vertical" Spacing="8">
                                    <TextBlock Text="{x:Static lang:language.Reports_BtcMetrics_ErrorTitle}"
                                               FontSize="{DynamicResource FontSizeLarge}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text200Brush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Static lang:language.Reports_BtcMetrics_ErrorBody}"
                                                   FontSize="{DynamicResource FontSizeNormal}"
                                                   Foreground="{DynamicResource Text400Brush}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   MaxWidth="500"
                                                   HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Panel>
                        <TextBlock Text="{x:Static lang:language.Loading}" FontSize="{DynamicResource FontSizeMedium}" Foreground="{DynamicResource Text400Brush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding IsStackVelocityLoading}" />
                    </Grid>
                </StackPanel>
            </Expander>
            <!--Categories-->
            <Expander Classes="section" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="section-header-icon" Text="&#xE24B;" />
                        <TextBlock Classes="section-header" Text="{x:Static lang:language.Reports_ByCategories_Title}" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{x:Static lang:language.Reports_ByCategories_Description}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource Text500Brush}"
                               TextWrapping="Wrap"
                               MaxWidth="900"
                               Margin="0,0,0,12" />
                    <userControls:DateCalendarSelector HorizontalContentAlignment="Center"
                                                       Height="60"
                                                       Date="{Binding CategoryFilterMainDate}"
                                                       Range="{Binding CategoryFilterRange}">
                        <userControls:DateCalendarSelector.AllowedSelectorModes>
                            <userControls:DateCalendarSelectorMode>Month</userControls:DateCalendarSelectorMode>
                            <userControls:DateCalendarSelectorMode>Year</userControls:DateCalendarSelectorMode>
                            <userControls:DateCalendarSelectorMode>All</userControls:DateCalendarSelectorMode>
                        </userControls:DateCalendarSelector.AllowedSelectorModes>
                    </userControls:DateCalendarSelector>
                    <Grid ColumnDefinitions="300, *" MinHeight="600">
                        <Border Grid.Column="0"
                                Background="{DynamicResource Background900Brush}"
                                BorderBrush="{DynamicResource Background700Brush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10"
                                Margin="0, 0, 10, 0">
                            <StackPanel Orientation="Vertical" Spacing="10">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Static lang:language.Reports_ByCategories_Filters}"
                                               FontSize="{DynamicResource FontSizeMedium}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="ExpensesCategoryFilterButton"
                                            Grid.Column="1"
                                            Classes="transparent" Padding="2" HorizontalAlignment="Right"
                                            Click="OnFilterSettingsButtonClick">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{x:Static lang:language.Reports_CategoryFilter_SaveAsDefault}"
                                                          Command="{Binding SaveExpensesCategoryFilterCommand}" />
                                                <MenuItem Header="{x:Static lang:language.Reports_CategoryFilter_LoadDefault}"
                                                          Command="{Binding LoadExpensesCategoryFilterCommand}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <TextBlock FontFamily="{DynamicResource MaterialDesign}" Text="&#xE8B8;" FontSize="16"
                                                   Foreground="{DynamicResource Text300Brush}" />
                                    </Button>
                                </Grid>
                                <userControls:CheckboxListSelector
                                    Title="{x:Static lang:language.Reports_SpendingByCategories_Accounts}"
                                    DisplayMemberPath="Name"
                                    MaxListHeight="280"
                                    ItemsSource="{Binding AvailableAccounts}"
                                    SelectedItems="{Binding SelectedAccounts}" />
                                <userControls:CheckboxListSelector
                                    Title="{x:Static lang:language.Reports_SpendingByCategories_Categories}"
                                    DisplayMemberPath="Name"
                                    MaxListHeight="300"
                                    ItemsSource="{Binding AvailableCategories}"
                                    SelectedItems="{Binding SelectedCategories}" />
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="20">
                            <!--Expenses chart-->
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{x:Static lang:language.Reports_ByCategories_Expenses}"
                                           FontSize="{DynamicResource FontSizeLarge}"
                                           Foreground="{DynamicResource Text200Brush}"
                                           Margin="0,0,0,8" />
                                <Panel>
                                    <Border Background="{DynamicResource Background900Brush}"
                                            BorderBrush="{DynamicResource Background700Brush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10"
                                            IsVisible="{Binding !IsSpendingByCategoriesLoading}">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="{Binding ExpensesByCategoryChartData.TotalText}"
                                                       FontSize="{DynamicResource FontSizeMedium}"
                                                       Foreground="{DynamicResource Text200Brush}"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,0,20,0" />
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          MaxHeight="600">
                                                <avalonia:CartesianChart x:Name="CategoryBarChart"
                                                                         Background="{DynamicResource Background900Brush}"
                                                                         Height="{Binding ExpensesByCategoryChartData.ChartHeight}"
                                                                         Series="{Binding ExpensesByCategoryChartData.Series}"
                                                                         XAxes="{Binding ExpensesByCategoryChartData.XAxes}"
                                                                         YAxes="{Binding ExpensesByCategoryChartData.YAxes}"
                                                                         TooltipTextSize="12"
                                                                         ZoomMode="None"
                                                                         Margin="20, 10, 20, 10">
                                                </avalonia:CartesianChart>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{x:Static lang:language.Loading}" FontSize="{DynamicResource FontSizeMedium}" Foreground="{DynamicResource Text400Brush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding IsSpendingByCategoriesLoading}" />
                                </Panel>
                            </StackPanel>
                            <!--Income chart-->
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{x:Static lang:language.Reports_ByCategories_Income}"
                                           FontSize="{DynamicResource FontSizeLarge}"
                                           Foreground="{DynamicResource Text200Brush}"
                                           Margin="0,0,0,8" />
                                <Panel>
                                    <Border Background="{DynamicResource Background900Brush}"
                                            BorderBrush="{DynamicResource Background700Brush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10"
                                            IsVisible="{Binding !IsIncomeByCategoriesLoading}">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="{Binding IncomeByCategoryChartData.TotalText}"
                                                       FontSize="{DynamicResource FontSizeMedium}"
                                                       Foreground="{DynamicResource Text200Brush}"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,0,20,0" />
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          MaxHeight="600">
                                                <avalonia:CartesianChart x:Name="IncomeCategoryBarChart"
                                                                         Background="{DynamicResource Background900Brush}"
                                                                         Height="{Binding IncomeByCategoryChartData.ChartHeight}"
                                                                         Series="{Binding IncomeByCategoryChartData.Series}"
                                                                         XAxes="{Binding IncomeByCategoryChartData.XAxes}"
                                                                         YAxes="{Binding IncomeByCategoryChartData.YAxes}"
                                                                         TooltipTextSize="12"
                                                                         ZoomMode="None"
                                                                         Margin="20, 10, 20, 10">
                                                </avalonia:CartesianChart>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{x:Static lang:language.Loading}" FontSize="{DynamicResource FontSizeMedium}" Foreground="{DynamicResource Text400Brush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding IsIncomeByCategoriesLoading}" />
                                </Panel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Expander>
        </StackPanel>
        </ScrollViewer>
        <!-- Secure Mode Overlay -->
        <Border Grid.Row="1" IsVisible="{Binding IsSecureModeEnabled}"
                Background="{DynamicResource Background800Brush}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <TextBlock Text="{x:Static lang:language.Reports_SecureModeMessage}"
                       FontSize="{DynamicResource FontSizeXLarge}"
                       Foreground="{DynamicResource Text400Brush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>